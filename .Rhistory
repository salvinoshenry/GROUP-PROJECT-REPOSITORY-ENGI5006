# ============================================================
# STAGE 8: MODEL DEVELOPMENT
# Adelaide Airport Monthly Rainfall, 1990–2025
# ============================================================
# Install packages if needed
# install.packages("readxl")
# install.packages("dplyr")
# install.packages("forecast")
# install.packages("ggplot2")
# Load packages
library(readxl)
library(dplyr)
library(forecast)
library(ggplot2)
# ------------------------------------------------------------
# 1. Import monthly rainfall dataset
# ------------------------------------------------------------
monthly_data <- read_excel("Monthly Rainfall.xlsx")
# Check data
head(monthly_data)
names(monthly_data)
# ------------------------------------------------------------
# 2. Create Date column and sort data
# ------------------------------------------------------------
monthly_data <- monthly_data %>%
mutate(
Date = as.Date(paste(Year, Month, "01", sep = "-"))
) %>%
arrange(Date)
# Check first and last rows
head(monthly_data)
tail(monthly_data)
# ------------------------------------------------------------
# 3. Convert rainfall data into a time-series object
# ------------------------------------------------------------
rainfall_ts <- ts(
monthly_data$`Rainfall (mm)`,
start = c(1990, 1),
frequency = 12
)
# Check time series
rainfall_ts
start(rainfall_ts)
end(rainfall_ts)
frequency(rainfall_ts)
# ------------------------------------------------------------
# 4. Fit ARIMA/SARIMA model automatically
# ------------------------------------------------------------
rainfall_model <- auto.arima(
rainfall_ts,
seasonal = TRUE,
stepwise = FALSE,
approximation = FALSE
)
# Show model
rainfall_model
# Full model summary
summary(rainfall_model)
# ------------------------------------------------------------
# 5. Save model summary to text file
# ------------------------------------------------------------
sink("Stage_8_ARIMA_Model_Summary.txt")
cat("STAGE 8: ARIMA/SARIMA MODEL DEVELOPMENT\n")
cat("Adelaide Airport Monthly Rainfall, 1990–2025\n\n")
print(rainfall_model)
cat("\n\nFull Model Summary:\n")
print(summary(rainfall_model))
sink()
# ------------------------------------------------------------
# 6. Check residuals
# ------------------------------------------------------------
png(
filename = "Stage_8_Model_Residuals.png",
width = 1000,
height = 800
)
checkresiduals(rainfall_model)
dev.off()
# Also show residual check inside R Studio
checkresiduals(rainfall_model)
# ------------------------------------------------------------
# 7. Calculate model accuracy
# ------------------------------------------------------------
model_accuracy <- accuracy(rainfall_model)
model_accuracy
# Save accuracy table
write.csv(
model_accuracy,
"Stage_8_Model_Accuracy.csv",
row.names = TRUE
)
# ------------------------------------------------------------
# 8. Extract key model information
# ------------------------------------------------------------
cat("\nSTAGE 8 COMPLETE\n")
cat("Selected model:\n")
print(rainfall_model)
cat("\nModel accuracy:\n")
print(model_accuracy)
cat("\nFiles saved:\n")
cat("- Stage_8_ARIMA_Model_Summary.txt\n")
cat("- Stage_8_Model_Residuals.png\n")
cat("- Stage_8_Model_Accuracy.csv\n")
View(monthly_data)
View(model_accuracy)
View(monthly_data)
View(rainfall_model)
View(monthly_data)
